{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TiyraSense Mobile (Debug)",
      "request": "launch",
      "type": "dart",
      "cwd": "mobile",
      "program": "mobile/lib/main.dart",
      "args": [
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "TiyraSense Mobile (Release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "cwd": "mobile",
      "program": "mobile/lib/main.dart",
      "args": [
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "TiyraSense Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ]
    }
  ]
}
